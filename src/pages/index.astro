---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Channels from '../components/Channels.astro';
import Reels from '../components/Reels.astro';
import Story from '../components/Story.astro';
import Photos from '../components/Photos.astro';
import Gyan from '../components/Gyan.astro';
import Wealth from '../components/Wealth.astro';
import Work from '../components/Work.astro';
import Footer from '../components/Footer.astro';
import { getTips } from '../lib/gyan.js';

const tips = await getTips();
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tips.map((t) => ({ '@type': 'Question', name: t.data.question, acceptedAnswer: { '@type': 'Answer', text: t.data.short } }))
};
---
<Layout jsonLd={[faq]}>
  <Header />
  <main class="wrap" id="top">
    <Hero />
    <Marquee />
    <Channels />
    <Reels />
    <Story />
    <Photos />
    <Gyan />
    <Wealth />
    <Work />
  </main>
  <Footer />
</Layout>
