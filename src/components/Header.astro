---
import { site } from '../data/site.js';
---
<div class="cursor" aria-hidden="true"><span class="cursor-dot"><b></b></span></div>
<canvas id="confetti" aria-hidden="true"></canvas>
<div class="progress" aria-hidden="true"><i id="prog"></i></div>

<header class="bar">
  <a class="mark" href="/" aria-label="Jagriti Verma, back to top">JV</a>
  <nav aria-label="Sections"><a href="/#channels">Channels</a><a href="/#reels">Reels</a><a href="/#story">Story</a><a href="/#photos">Photos</a><a href="/gyan">Free ka gyan</a></nav>
  <div class="bar-end">
    <a class="btn mag sm" href="/work">Work with me</a>
    <button class="snd" id="snd" type="button" aria-pressed="false" aria-label="Play background music" data-cursor="Music" data-audio={site.audio}>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="lbl">Sound</span>
    </button>
    <button class="theme" id="theme" type="button" aria-label="Switch between light and dark theme">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
    </button>
  </div>
</header>
